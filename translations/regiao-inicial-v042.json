  "name": "regiao-inicial-v042",
  "status": "Trinta e seis rótulos completos com revisão contextual das falas; treze preservados por limite de espaço.",
  "translations": {
    "map.msgn.04d31c1c": "Nem sabe como\nestou ocupado. ...Odeio\nesses prazos apertados!",
    "map.msgn.0a618a7c": "Garoto, ganhei o dia!",
    "map.msgn.0be1b1fc": "A senhorita Rosa mostrou\nquem manda ao Exército\nBlueberry! Foi show!",
    "map.msgn.0be24d4c": "É o tal!",
    "map.msgn.0be24de4": "Valeu! Veio a calhar.",
    "map.msgn.0be24e38": "O rei da breja!",
    "map.msgn.0be24eec": "Bem, boa sorte.",
    "map.msgn.0db1402c": "Vamos queimar óleo\naté tarde! Ha! Sacou?",
    "map.msgn.0db1484c": "Whoa!",
    "map.msgn.0e76bbd8": "Hmph. Balas não\nvalem nada se\nerram o alvo.",
    "map.msgn.0e76e41c": "Vou curtir a bebida.",
    "map.msgn.0e76e8f4": "Minha espada vai\nte proteger,\njovem Hunter.",
    "map.msgn.0e76f604": "Sinto muito.",
    "map.msgn.0e770150": "Valeu mesmo!",
    "map.msgn.0e7701a4": "Oba! Bebida grátis!",
    "map.msgn.0f834ec4": "Ei, cara! Beleza?",
    "map.msgn.0f838cc0": "Whoa, incrível!\nParabéns!",
    "map.msgn.0f838e34": "Que incrível!",
    "map.msgn.0f83ce50": "O quê!? Por que\nmoramos sob gente\nde quem não gostamos?\tNão! Não!\nEntendeu errado!\tELES vieram depois!\nNós viemos primeiro!",
    "map.msgn.0f83d2ec": "Veio a calhar!",
    "map.msgn.14aad104": "Um brinde aos\nbons tempos!",
    "map.msgn.14aad164": "Viva, viva, viva!",
    "map.msgn.14aad218": "Beber é meu\nlazer favorito!",
    "map.msgn.14aad6dc": "Obrigado, senhor!\nMais uma?",
    "map.msgn.14aad7b8": "Meu camarada!",
    "map.msgn.14aafd5c": "Boa!",
    "map.msgn.14aafda0": "Valeu!",
    "map.msgn.14aafde8": "Yeah! Grátis!",
    "map.msgn.169b813c": "...Wow, fechado!",
    "map.msgn.17742988": "Um brinde a você,\nrapaz.",
    "map.msgn.1df72a08": "Ah, opa?",
    "map.msgn.1df7a4a4": "Ah, é o\nfilho de Eddy.",
    "map.msgn.1df7b0f8": "Tanta bebida,\npouco tempo!",
    "map.msgn.1df8abd0": "Nossa, você é feito\nde grana, é?"
  },
