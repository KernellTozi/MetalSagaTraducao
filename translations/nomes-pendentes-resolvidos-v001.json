    {
      "id": "map.msg.0e551d94",
      "parent_value_sha256": "69c83a36f0578d71cd7323f270975ce045d3c5611fffbb465edc445e50580f08",
      "source_body_sha256": "7981bc395abb2c79b3b25421ecd2f14f822f37ae3e693e3cb2abd8dc7fce0e51",
      "source_record_sha256": "1ca6ccf396d332f01716d144442c5774db1132aad485dbf1f09701f8dcc62127",
      "translation": "Ei, a Placa de\nônibus foi útil\npara você?"
    },
    {
      "id": "map.msgn.0e76fcc4",
      "parent_value_sha256": "9a02902c0ca5dd7a7bee3788f8fa1a32fdbc36f18ebaecb015c2f3eb5a37f5ce",
      "source_body_sha256": "d4bf59da67bac2814cbfabbcd787d618c97865695421a6bec075cf049795e181",
      "source_record_sha256": "a73f1a7831ee0b4a37857ce1b0005e40d37898ba804e469f1b69e95b5c76569b",
      "translation": "É isso que\ngosto de ouvir!\tBons Hunters juntam\no máximo de veículos.\tPor isso ganham\ntanto dinheiro!\tAgora, escute...\nA oeste, há um\nacampamento mercante.\tCompre uma\nPlaca de ônibus na\nloja de sucata.\tO dono vai\nexplicar o que\nfazer depois.\tBoa sorte, garoto!"
    },
    {
      "id": "map.smsg.06493b00",
      "parent_value_sha256": "7fd447478b728b215c8086c13ef6a3c92f0ec097508277243caf040986834675",
      "source_body_sha256": "3fab93529f1a15d8ffe3a8bac3dc7450ad23a013da27e1c042389becb25d43db",
      "source_record_sha256": "459e6d7510dc0a441e253524fe54eda761b1d6a6a0dc609b36d7b700f615b989",
      "translation": {
        "body": "Tirar a Placa de ônibus?",
        "choices": "Viva o vandalismo!\tÉ ilegal!"
      }
    },
    {
      "id": "map.smsg.0e5517d4",
      "parent_value_sha256": "51d80163876bf4c058a161f08b47f18b04dfed51fe27b5bd1b95232647e97d7f",
      "source_body_sha256": "729324a3f3268295188411bf96ca9762a1eeb7a6a302b899478250832d712527",
      "source_record_sha256": "e48b5c571c874beeb48c51c49e32c2a08dc7b4138da34ebe2c64b7b7a5ed7c6f",
      "translation": {
        "body": "Ei, quer a Placa\nde ônibus? É bem\nrara...\tMas posso vender\npor %$10G.\nFechado?",
        "choices": "Fechado.\tNem pensar."
      }
    }
