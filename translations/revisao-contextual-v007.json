      "span": 111,
      "compiled_next_segment_offset": 199372080,
      "old_body_bytes": 93,
      "new_body_bytes": 110,
      "translation": "A nordeste, há\numa ponte para\nTorikami.\tO leste está cheio de\nScorpions, mas é onde\nse ganha mais dinheiro.",
      "warnings": []
    },
