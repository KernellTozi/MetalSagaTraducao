      "span": 131,
      "compiled_next_segment_offset": 242714392,
      "old_body_bytes": 99,
      "new_body_bytes": 130,
      "translation": "Levo cargas, sobretudo,\npara o oeste.\tCostumo levar grãos\ne álcool.\tO frete dessas cargas\npaga bem, mas menos\nque o de verduras.",
      "warnings": []
    },
